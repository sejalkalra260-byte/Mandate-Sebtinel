# Copy to .env and fill in. Everything here is optional - with no key at all the
# agents run on the deterministic offline rule engine and the whole demo still works.

# --- Option A: AWS Bedrock (takes priority when USE_BEDROCK=1)
USE_BEDROCK=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
BEDROCK_MODEL_FAST=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_SMART=global.anthropic.claude-opus-4-8

# --- Option B: direct Anthropic API
ANTHROPIC_API_KEY=

# Model tiering: cheap+fast for classification and review, stronger for decisions
# and composition. Check the current model IDs at
# https://docs.claude.com/en/docs/about-claude/models
MODEL_FAST=claude-haiku-4-5
MODEL_SMART=claude-sonnet-4-5

# Force the offline rule engine even when a key is present (useful for rehearsing)
MOCK_LLM=0

# Set to 0 if you are demoing late at night and want messages to send immediately
# instead of being deferred to 09:00 IST.
QUIET_HOURS_ENABLED=1

MERCHANT_NAME=Streamly
SEED_SUBSCRIPTIONS=1200
